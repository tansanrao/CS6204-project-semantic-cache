# Base URL of the upstream OpenAI-compatible backend
PROXY_VLLM_BASE_URL=http://localhost:8000/v1

# Optional bearer token the proxy should present to the upstream service
# PROXY_VLLM_API_KEY=backend-secret

# Optional comma-separated list of client API keys accepted by the proxy
# PROXY_INBOUND_API_KEYS=client-key-1,client-key-2

# Timeout (seconds) applied to outbound requests to the upstream backend
# PROXY_REQUEST_TIMEOUT_SECONDS=30

# --- Semantic cache configuration ---
# PROXY_DATABASE_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/semantic_cache
# PROXY_QDRANT_URL=http://localhost:6333
# PROXY_QDRANT_API_KEY=local-qdrant-token
# PROXY_QDRANT_COLLECTION_NAME=cache_entries
# PROXY_SEMANTIC_CACHE_ENABLED=false
# PROXY_SEMANTIC_CACHE_BOOTSTRAP=true
# PROXY_EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# PROXY_EMBEDDING_MODEL_MODE=clustering
# PROXY_EMBEDDING_DIMENSION=768
# PROXY_EMBEDDING_DEVICE=cpu
# PROXY_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.86
# PROXY_SEMANTIC_CACHE_SEARCH_LIMIT=5
# PROXY_SEMANTIC_CACHE_DEFAULT_TTL_BUCKET=2
# PROXY_SEMANTIC_CACHE_BUCKET_SECONDS=60,300,900,1800,3600,7200
